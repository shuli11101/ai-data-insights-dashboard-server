# 生产环境变量模板
# 用法：复制为 .env.prod 后逐项填写，启动时用 --env-file .env.prod 显式指定
#   cp .env.prod.example .env.prod && vi .env.prod
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build

# ============ 对外端口 ============
# nginx 监听端口；用 IP 直接访问时保持 80
HTTP_PORT=80

# ============ MySQL ============
# 用 compose 自带的 mysql 容器时填 mysql；
# 改用云 RDS 时填 RDS 内网地址，并从 docker-compose.prod.yml 删掉 mysql 服务
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=recruitment_dashboard
# 应用连接用的业务账号，mysql 容器会自动创建并授权到上面的库
MYSQL_USERNAME=app_user
MYSQL_PASSWORD=请替换
# 仅容器 MySQL 使用：root 密码，用于健康检查与初始化；用 RDS 时可留空
MYSQL_ROOT_PASSWORD=请替换

# ============ JWT ============
# 必填。application-prod.yml 故意没有默认值，缺失会直接启动失败
# 生成方式：openssl rand -base64 48
JWT_SECRET=请替换为随机字符串

# ============ 跨域 ============
# 同域部署（nginx 同时托管前端和 /api）时浏览器不触发 CORS，可留空
# 若前端单独部署，填完整域名，多个用逗号分隔：https://www.example.com
CORS_ALLOWED_ORIGINS=

# ============ Redis（容器内） ============
# compose 用它做 requirepass，server 用它连接
REDIS_PASSWORD=请替换

# ============ AI 服务 ============
# 必须与 ai-service 的 AI_INTERNAL_TOKEN 完全一致，否则内部调用返回 401
AI_INTERNAL_TOKEN=请替换为随机字符串
AI_PROVIDER=deepseek
AI_DEEPSEEK_API_KEY=sk-请替换

# ============ 对象存储（MinIO） ============
# prod profile 默认 storage-type=s3，缺这些配置会启动失败
UPLOAD_STORAGE_TYPE=s3
# 容器内访问地址，不要改成公网地址
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
# MinIO 要求至少 8 位
S3_SECRET_KEY=请替换至少8位
S3_BUCKET=ai-insights
# MinIO 必须 true，OSS/COS 一般为 false
S3_PATH_STYLE=true
S3_REGION=us-east-1
# 浏览器访问头像用的前缀。9000 已映射到宿主机，先用 http://<服务器公网IP>:9000/ai-insights
# 注意：把 9000 暴露公网只适合内测；正式对外建议换成 OSS/COS + CDN，或由 nginx 反代 /uploads
S3_PUBLIC_BASE_URL=http://请替换为服务器公网IP:9000/ai-insights

# ============ 日志 ============
# 容器内路径，compose 已挂载到宿主机的 deploy/logs/server
LOG_PATH=/app/logs